#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # 開発環境の準備を行う。何度実行しても同じ結果になるようにする。
  #
  # server は起動しない。開発と検証の経路は Docker Compose を正本とし、
  # server と worker は compose が起動する。ここで起動すると、
  # 既に動いている server とぶつかり、準備が終わっているのに失敗として返る。
  #
  # 破壊的な操作も持たない。作り直しは worker の接続を切る必要があり、
  # Compose の service を止める操作を伴う。それはコンテナの中からは行えない。
  # 作り直しは script/reset_development が受け持つ。

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"
end
