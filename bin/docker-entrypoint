#!/bin/bash -e

# サーバーを起動する場合だけ、データベースを利用可能な状態にする。
# 初回起動時に利用者へ別コマンドの実行を求めないため、ここで吸収する。
#
# 準備を別の実行が受け持つ構成では、ここでは行わない。行うと、応答を始める
# までの時間がその分だけ延び、稼働確認はそれを「応えない」としか見られない。
# 準備が長引いた回だけ、起動そのものが失敗したように扱われる。
if [ "${1}" = "bin/rails" ] && [ "${2}" = "server" ]; then
  # 異常終了で残った PID ファイルがあると起動に失敗する。
  rm -f tmp/pids/server.pid

  if [ "${DATABASE_PREPARED_ELSEWHERE:-0}" != "1" ]; then
    ./bin/rails db:prepare
  fi
fi

exec "${@}"
