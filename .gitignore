# OS が生成する一時ファイル
.DS_Store
Thumbs.db
desktop.ini

# エディターが生成する一時ファイル
*.swp
*.swo
*~
.idea/
.vscode/

# 一時ファイルとログ
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep

# アップロードされたファイル
/storage/*
!/storage/.keep

# ビルド済みアセット
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# システムテストが出力する画面画像
/tmp/screenshots/

# 環境ごとの設定と秘密情報。リポジトリへ含めない。
/.env
/.env.*
!/.env.example
/config/master.key
/config/credentials/*.key
backups/

# 脆弱性検査の報告。実行のたびに変わるため、リポジトリへ含めない。
scan_report/

# 負荷測定の報告。実行のたびに変わるため、リポジトリへ含めない。
load_report/
