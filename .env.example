# このファイルを .env として複製し、必要な値を書き換えてください。
# .env はリポジトリへ含めません。実際の秘密情報をこのファイルへ書かないでください。

# データベース接続
#
# DATABASE_PASSWORD は配布用の構成では必須です。空欄のままでは構成を解決できず、
# 起動しません。開発用の構成では、空欄のまま開発専用の値を使います。
DATABASE_USER=officeweave
DATABASE_PASSWORD=
DATABASE_NAME=officeweave_development

# 未処理のジョブを置くデータベース。
# 接続先は同じ PostgreSQL で、論理データベースだけを分けます。
# 業務データと混ぜると、バックアップの対象や接続数の見積もりが絡み合います。
QUEUE_DATABASE_NAME=officeweave_development_queue

# worker がジョブ用データベースへ張る接続の上限。
# 実行 thread のほかに、待機と heartbeat でも接続を使います。
# JOB_THREADS + 2 以上にしてください。
QUEUE_DATABASE_CONNECTIONS=5

# 1 つの worker process が同時に実行するジョブ数。
JOB_THREADS=2

# worker process の数。単一ホストでは 1 から始めます。
JOB_PROCESSES=1

# ホスト側で公開するアドレスとポート。
# 既定では loopback にだけ公開します。逆プロキシを使わず外部へ直接公開する場合に限り、
# WEB_BIND_ADDRESS=0.0.0.0 を明示してください。
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3210

# データベースをホストへ公開するポート。
# 通常の起動では公開しません。この値は、ホストの DB クライアントから直接つなぐために
# compose.database.yaml を重ねて指定した場合にだけ使われます。
#
#   docker compose -f compose.yaml -f compose.database.yaml up -d
DATABASE_PUBLISHED_PORT=55432

# 導入単位となる組織。script/seed_initial_user で作成されます。
ORGANIZATION_NAME=OfficeWeave
ORGANIZATION_CODE=default

# 初期利用者。script/seed_initial_user で作成されます。
#
# 既定値はありません。メールアドレスとパスワードの両方を設定するまで、
# 初期利用者は作成されません。開発環境も同じです。
#
# パスワードは 15 文字以上にしてください。大文字・数字・記号の混在は不要です。
# 空白を含めても構いませんが、空白だけの値は使用できません。
# change_me、password、officeweave は、表記を変えても使用できません。
#
# これらは script/seed_initial_user が一時コンテナへだけ渡します。
# 稼働し続ける web と worker の環境へは渡しません。
#
# 作成後は INITIAL_USER_PASSWORD をこのファイルから削除してください。
# web と worker を作り直す必要はありません。
INITIAL_USER_NAME=管理者
INITIAL_USER_EMAIL=admin@example.com
INITIAL_USER_PASSWORD=

# メール送信。SMTP_ADDRESS を設定すると送信を開始します。
# 未設定の場合、開発環境では tmp/mails へ書き出し、それ以外では送信しません。
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USER_NAME=officeweave
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS=true
MAIL_FROM=officeweave@example.com

# 利用者が接続するホスト名。運用環境では必ず設定してください。
#
# 用途は 2 つあります。
#   1. メール本文へ載せる URL の組み立て
#   2. 受け入れる Host の許可
#
# 運用環境では、ここに書いた 1 つのホスト名だけを受け入れます。
# 異なる Host を持つ要求は 403 で拒否します。稼働確認の /up と /health も
# 例外にしません。ループバックの IP へ直接確かめるときは、
# Host ヘッダーへこの値を付けてください。
#
# スキーム、経路、ポートは含めません。ホスト名だけを書きます。
#   正: officeweave.example.com
#   誤: https://officeweave.example.com/
#
# IPv6 は角括弧で囲み、ゾーン識別子は含めません。
#   正: [2001:db8::10]
#   誤: [fe80::1%eth0]
#
# localhost やループバックの IP のままでも起動しますが、
# 利用者へ送る URL としては使えません。bin/diagnose が注意として知らせます。
#
# 値は起動時に検査します。不正な値では web も worker も起動しません。
# 前後の空白は取り除かず、そのまま誤設定として扱います。
#
# 行ごとコメントアウトした未設定と、APPLICATION_HOST= と書いた空欄は異なります。
# 未設定の場合、配布用の構成は localhost に閉じます。
# 空欄は誤設定として起動を拒否します。localhost へは切り替わりません。
#
# 逆プロキシの背後で別のホスト名を使っていると、正規の要求も 403 になります。
# APPLICATION_HOST=officeweave.example.com
# APPLICATION_PROTOCOL=https

# メール本文など、利用者向けの公開 URL へ付けるポート。
#
# 上の WEB_PORT とは別物です。WEB_PORT はホストから web コンテナへ公開する
# ポートで、逆プロキシの背後では利用者が接続するポートと一致しません。
# そのため、公開 URL のポートを WEB_PORT から自動では決めません。
#
# 利用者が 80 または 443 以外のポートへ接続する場合に設定します。
# 逆プロキシの有無とは関係ありません。
#
#   https://officeweave.example.com        未設定のままにします
#   https://officeweave.example.com:8443   APPLICATION_PORT=8443
#   http://officeweave.example.com:3210    APPLICATION_PORT=3210
#
# 1 から 65535 までの整数だけを受け付けます。それ以外では起動しません。
# APPLICATION_PORT=3210

# 認証方式。未設定の場合は内部認証を使います。
#
# internal 以外を使う場合は、先にアプリケーションへその方式を登録します。
# 登録していない名前、空欄、前後に空白を含む値を指定すると起動しません。
# 内部認証へは切り替わりません。設定の誤りは起動しないことで分かります。
# AUTHENTICATION_PROVIDER=internal

# Webhook の内部宛先の許可。
#
# 既定では、組織の外にある http / https の宛先だけへ送信します。
# ループバック、私用アドレス、リンクローカルなどへは送信しません。
#
# 閉じたネットワーク内の宛先へ送る必要がある場合に限り、
# 完全な origin をカンマ区切りで指定します。
#
#   WEBHOOK_PRIVATE_DESTINATION_ALLOWLIST=http://hooks.internal.example,https://10.0.0.20
#
# 警告: これは防御を弱める設定です。指定した origin へは、
# 内部ネットワークであっても送信できるようになります。
# ワイルドカード（*.internal.example）と CIDR（10.0.0.0/8）は使えません。
# 設定したら bin/diagnose で確認してください。
WEBHOOK_PRIVATE_DESTINATION_ALLOWLIST=

# 暗号化された通信を必須にするか。逆プロキシで終端する構成では true のままにします。
# 内部ネットワークだけで平文運用する場合に限り false にします。
FORCE_SSL=true

# 実行環境（development / test / production）
RAILS_ENV=development
