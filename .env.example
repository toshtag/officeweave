# このファイルを .env として複製し、必要な値を書き換えてください。
# .env はリポジトリへ含めません。実際の秘密情報をこのファイルへ書かないでください。
#
# 各変数の条件、既定値、誤った値を設定したときの振る舞いは、設定の文書が正本です。
# ここには変数と、値を決めるための 1 行だけを置きます。
#
#   docs/development/configuration.md

# データベース接続。
# DATABASE_PASSWORD は配布用では必須です。空欄では構成を解決できず起動しません。
DATABASE_USER=officeweave
DATABASE_PASSWORD=
DATABASE_NAME=officeweave_development

# 未処理のジョブを置くデータベース。接続先は同じ PostgreSQL で、論理データベースだけを分けます。
QUEUE_DATABASE_NAME=officeweave_development_queue

# worker がジョブ用データベースへ張る接続の上限。JOB_THREADS + 2 以上にしてください。
QUEUE_DATABASE_CONNECTIONS=5

# 1 つの worker process が同時に実行するジョブ数。
JOB_THREADS=2

# worker process の数。単一ホストでは 1 から始めます。
JOB_PROCESSES=1

# 署名に使う鍵。配布用では必須です。空欄では構成を解決できず起動しません。
# 開発環境とテスト環境では Rails が用意するため、設定しません。
# 値は bin/rails secret で作れます。
SECRET_KEY_BASE=

# ホスト側で公開するアドレスとポート。既定では loopback にだけ公開します。
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3210

# データベースをホストへ公開するポート。
# compose.database.yaml を重ねて起動した場合にだけ使われます。
DATABASE_PUBLISHED_PORT=55432

# 導入単位となる組織。script/seed_initial_user で作成されます。
ORGANIZATION_NAME=OfficeWeave
ORGANIZATION_CODE=default

# 初期利用者。script/seed_initial_user で作成されます。
# 既定値はありません。メールアドレスとパスワードの両方を設定するまで作成されません。
# パスワードは 15 文字以上にしてください。
# 作成後は INITIAL_USER_PASSWORD をこのファイルから削除してください。
INITIAL_USER_NAME=管理者
INITIAL_USER_EMAIL=admin@example.com
INITIAL_USER_PASSWORD=

# メール送信。SMTP_ADDRESS を設定すると送信を開始します。
# 未設定の場合、開発環境では tmp/mails へ書き出し、それ以外では送信しません。
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_DOMAIN=example.com
# SMTP_USER_NAME=officeweave
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS=true
MAIL_FROM=officeweave@example.com

# 利用者が接続するホスト名。運用環境では必ず設定してください。
# メール本文の URL の組み立てと、受け入れる Host の許可に使います。
# スキーム、経路、ポートは含めません。誤った値では web も worker も起動しません。
# 行ごとコメントアウトした未設定と、APPLICATION_HOST= と書いた空欄は異なります。
# APPLICATION_HOST=officeweave.example.com
# APPLICATION_PROTOCOL=https

# 公開 URL へ付けるポート。上の WEB_PORT とは別物で、値を流用しません。
# 利用者が 80 または 443 以外のポートへ接続する場合に設定します。
# APPLICATION_PORT=3210

# 認証方式。未設定の場合は内部認証を使います。
# 登録していない名前、空欄、前後に空白を含む値では起動しません。
# AUTHENTICATION_PROVIDER=internal

# 監査記録を残す日数。設定した場合だけ、古い記録を毎日削除します。
# 未設定と空欄では削除しません。0 や整数でない値では起動しません。
# AUDIT_RETENTION_DAYS=365

# Webhook を内部の宛先へ送ることを許す origin。既定では送信しません。
# 防御を弱める設定です。設定したら bin/diagnose で確認してください。
WEBHOOK_PRIVATE_DESTINATION_ALLOWLIST=

# 暗号化された通信を必須にするか。
# 内部ネットワークだけで平文運用する場合に限り false にします。
FORCE_SSL=true

# 実行環境（development / test / production）
RAILS_ENV=development
