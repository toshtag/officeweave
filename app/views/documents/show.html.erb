<% content_for :title, @document.title %>

<article class="panel stack">
  <div class="page-heading">
    <div>
      <h1><%= @document.title %></h1>
      <p class="meta">
        <%= @document.document_category&.name || t("documents.no_category") %> ・
        <%= @document.author.name %> ・
        <%= l(@document.updated_at, format: :short) %> ・
        <%= t("documents.visibilities.#{@document.visibility}") %>
      </p>
    </div>

    <% if @document.editable_by?(Current.user) %>
      <div class="page-heading__actions">
        <%= link_to t("common.edit"), edit_document_path(@document), class: "button" %>
        <%= button_to t("common.destroy"), @document, method: :delete, class: "button" %>
      </div>
    <% end %>
  </div>

  <% if @document.limited_to_departments? %>
    <p class="meta">
      <%= t("documents.limited_to", names: Department.with_ancestors(@document.departments.ordered).map(&:display_path).to_sentence) %>
    </p>
  <% end %>

  <% if @document.body.present? %>
    <div class="prose"><%= formatted_body @document.body %></div>
  <% end %>

  <% if @document.attachments.attached? %>
    <section class="stack" aria-labelledby="document-attachments">
      <h2 id="document-attachments"><%= t("documents.attachments.heading") %></h2>
      <ul class="list-plain">
        <% @document.attachments.each do |attachment| %>
          <li>
            <%= link_to attachment.filename.to_s,
                        document_attachment_path(@document, attachment) %>
            <span class="meta"><%= number_to_human_size(attachment.byte_size) %></span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <p><%= link_to t("common.back"), documents_path %></p>
</article>
