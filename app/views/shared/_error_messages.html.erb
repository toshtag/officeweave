<%# 入力の誤りをまとめて示す。個々の入力欄の近くにも表示できるよう、ここでは一覧として扱う。 %>
<% if record.errors.any? %>
  <div class="error-summary" role="alert">
    <h2 class="error-summary__heading"><%= t("errors.summary", count: record.errors.count) %></h2>
    <ul>
      <% record.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
