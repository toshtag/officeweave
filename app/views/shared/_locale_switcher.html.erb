<%#
  言語の切り替え。JavaScript を使わず、送信だけで完結する。
  選択肢は自分自身の言語で表記する。翻訳すると、読めない言語で選ぶことになる。
%>
<%= form_with url: locale_path, method: :patch, class: "locale-switcher" do |form| %>
  <%= form.hidden_field :return_to, value: request.fullpath %>

  <div class="locale-switcher__group" role="group" aria-labelledby="locale-switcher-label">
    <span class="locale-switcher__label" id="locale-switcher-label"><%= t("locale_switcher.label") %></span>

    <% I18n.available_locales.each do |locale| %>
      <% if locale == I18n.locale %>
        <span class="locale-switcher__current" aria-current="true" lang="<%= locale %>">
          <%= t("locale_switcher.names.#{locale}") %>
        </span>
      <% else %>
        <%= form.button name: :locale, value: locale, class: "locale-switcher__option",
                        lang: locale, aria: { label: t("locale_switcher.switch_to", language: t("locale_switcher.names.#{locale}")) } do %>
          <%= t("locale_switcher.names.#{locale}") %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
