<% content_for :title, t("announcements.index.title") %>

<div class="stack">
  <div class="page-heading">
    <h1><%= t("announcements.index.heading") %></h1>
    <% if administrator? %>
      <%= link_to t("announcements.index.new"), new_announcement_path, class: "button" %>
    <% end %>
  </div>

  <form class="form form--inline" method="get" action="<%= announcements_path %>">
    <%= form_field do %>
      <%= label_tag :query, t("announcements.index.query"), class: "form__label" %>
      <%= search_field_tag :query, @query, class: "form__input" %>
    <% end %>
    <%= submit_tag t("events.index.filter"), class: "button", name: nil %>
  </form>

  <% if @announcements.any? %>
    <ul class="list-cards">
      <% @announcements.each do |announcement| %>
        <li class="panel stack">
          <h2>
            <%= link_to announcement.title, announcement %>
            <%= render "shared/unread_badge" if @unread_ids.include?(announcement.id) %>
          </h2>
          <p class="meta">
            <%= l(announcement.published_at, format: :short) %> ・
            <%= announcement.author.name %> ・
            <%= t("announcements.visibilities.#{announcement.visibility}") %>
          </p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p><%= t("announcements.index.empty") %></p>
  <% end %>

  <% if @scheduled.any? %>
    <section class="stack" aria-labelledby="announcement-scheduled">
      <h2 id="announcement-scheduled"><%= t("announcements.index.scheduled") %></h2>
      <ul class="list-cards">
        <% @scheduled.each do |announcement| %>
          <li class="panel stack">
            <h3><%= link_to announcement.title, announcement %></h3>
            <p class="meta">
              <%= t("announcements.scheduled_for", at: l(announcement.published_at, format: :short)) %> ・
              <%= announcement.author.name %>
            </p>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @drafts.any? %>
    <section class="stack" aria-labelledby="announcement-drafts">
      <h2 id="announcement-drafts"><%= t("announcements.index.drafts") %></h2>
      <ul class="list-cards">
        <% @drafts.each do |announcement| %>
          <li class="panel stack">
            <h3><%= link_to announcement.title, announcement %></h3>
            <p class="meta"><%= t("announcements.draft") %> ・ <%= announcement.author.name %></p>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= render "shared/pagination", page: @page, parameters: { query: @query } %>
</div>
