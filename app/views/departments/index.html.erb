<% content_for :title, t("departments.index.title") %>

<div class="stack">
  <div class="page-heading">
    <h1><%= t("departments.index.heading") %></h1>
    <% if administrator? %>
      <%= link_to t("departments.index.new"), new_department_path, class: "button" %>
    <% end %>
  </div>

  <% if @departments.any? %>
    <div class="panel">
      <div class="table-scroll" tabindex="0" role="region"
           aria-label="<%= t("shared.table.scrollable") %>">
        <table>
          <caption class="visually-hidden"><%= t("departments.index.heading") %></caption>
          <thead>
            <tr>
              <th scope="col"><%= Department.human_attribute_name(:name) %></th>
              <th scope="col"><%= Department.human_attribute_name(:code) %></th>
              <th scope="col"><%= Department.human_attribute_name(:parent) %></th>
            </tr>
          </thead>
          <tbody>
            <% @departments.each do |department| %>
              <tr>
                <td><%= link_to department.name, department %></td>
                <td><%= department.code %></td>
                <td><%= department.parent&.name || t("departments.no_parent") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <p><%= t("departments.index.empty") %></p>
  <% end %>

  <%= render "shared/pagination", page: @page, parameters: {} %>
</div>
