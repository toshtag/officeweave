<%= form_with model: department, class: "form stack" do |form| %>
  <%= render "shared/error_messages", record: department %>

  <div class="form__field">
    <%= form.label :name, class: "form__label" %>
    <%= form.text_field :name, required: true, class: "form__input" %>
  </div>

  <div class="form__field">
    <%= form.label :code, class: "form__label" %>
    <%= form.text_field :code, required: true, class: "form__input" %>
    <p class="form__hint"><%= t("departments.form.code_hint") %></p>
  </div>

  <div class="form__field">
    <%= form.label :parent_id, class: "form__label" %>
    <%= form.collection_select :parent_id, parent_candidates, :id, :display_path,
                               { include_blank: t("departments.no_parent") }, class: "form__input" %>
  </div>

  <div class="form__field">
    <%= form.label :position, class: "form__label" %>
    <%= form.number_field :position, class: "form__input" %>
    <p class="form__hint"><%= t("departments.form.position_hint") %></p>
  </div>

  <%= form.submit class: "button button--primary" %>
<% end %>
