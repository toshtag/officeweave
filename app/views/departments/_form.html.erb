<%= form_with model: department, class: "form stack" do |form| %>
  <%= render "shared/error_messages", record: department %>

  <%= form.field :name, :text_field, required: true %>
  <%= form.field :code, :text_field, required: true, hint: t("departments.form.code_hint") %>
  <%= form.field :parent_id, :collection_select, parent_candidates, :id, :display_path,
                 { include_blank: t("departments.no_parent") } %>
  <%= form.field :position, :number_field, hint: t("departments.form.position_hint") %>

  <%= form.submit class: "button button--primary" %>
<% end %>
