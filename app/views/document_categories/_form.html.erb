<%= form_with model: document_category, class: "form stack" do |form| %>
  <%= render "shared/error_messages", record: document_category %>

  <%= form.field :name, :text_field, required: true %>
  <%= form.field :code, :text_field, required: true %>
  <%= form.field :position, :number_field %>

  <%= form.submit class: "button button--primary" %>
<% end %>
