<% content_for :title, t("home.title") %>

<div class="stack">
  <div class="page-heading">
    <div>
      <h1><%= t("home.heading") %></h1>
      <p class="page-heading__note"><%= t("home.greeting", name: Current.user.name) %></p>
    </div>
  </div>

  <div class="card-grid">
    <section class="panel stack" aria-labelledby="home-profile">
      <h2 id="home-profile"><%= t("home.profile.heading") %></h2>
      <dl class="definition">
        <dt><%= User.human_attribute_name(:name) %></dt>
        <dd><%= Current.user.name %></dd>

        <dt><%= Organization.model_name.human %></dt>
        <dd><%= current_organization.name %></dd>

        <dt><%= Membership.human_attribute_name(:primary) %></dt>
        <dd><%= Current.user.primary_department&.display_path || t("home.profile.no_department") %></dd>

        <dt><%= User.human_attribute_name(:role) %></dt>
        <dd><%= t("roles.#{Current.user.role}") %></dd>
      </dl>
    </section>

    <section class="panel stack" aria-labelledby="home-announcements">
      <h2 id="home-announcements">
        <%= t("announcements.index.heading") %>
        <% if @unread_count.positive? %>
          <span class="badge badge--unread"><%= t("announcements.unread_count", count: @unread_count) %></span>
        <% end %>
      </h2>

      <% if @announcements.any? %>
        <ul class="list-plain">
          <% @announcements.each do |announcement| %>
            <li>
              <%= link_to announcement.title, announcement %>
              <%= render "shared/unread_badge" if @unread_ids.include?(announcement.id) %>
              <span class="meta"><%= l(announcement.published_at, format: :short) %></span>
            </li>
          <% end %>
        </ul>
        <p><%= link_to t("home.announcements.more"), announcements_path %></p>
      <% else %>
        <p><%= t("announcements.index.empty") %></p>
      <% end %>
    </section>

    <section class="panel stack" aria-labelledby="home-requests">
      <h2 id="home-requests"><%= t("home.requests.heading") %></h2>

      <% if @awaiting_requests.any? %>
        <h3><%= t("home.requests.awaiting", count: @awaiting_requests.size) %></h3>
        <ul class="list-plain">
          <% @awaiting_requests.each do |request| %>
            <li>
              <%= link_to request.title, request %>
              <span class="meta"><%= request.applicant.name %></span>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% if @open_requests.any? %>
        <h3><%= t("home.requests.mine") %></h3>
        <ul class="list-plain">
          <% @open_requests.each do |request| %>
            <li>
              <%= link_to request.title, request %>
              <%= render "requests/status", request: request %>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% if @awaiting_requests.empty? && @open_requests.empty? %>
        <p><%= t("home.requests.empty") %></p>
      <% end %>
    </section>

    <section class="panel stack" aria-labelledby="home-departments">
      <h2 id="home-departments"><%= t("home.departments.heading") %></h2>

      <% if Current.user.departments.any? %>
        <ul>
          <% Current.user.departments.ordered.each do |department| %>
            <li><%= link_to department.display_path, department %></li>
          <% end %>
        </ul>
      <% else %>
        <p><%= t("home.departments.empty") %></p>
      <% end %>
    </section>
  </div>
</div>
