<% content_for :title, t("settings.title") %>

<div class="panel panel--narrow stack">
  <h1><%= t("settings.heading") %></h1>

  <%= form_with model: @user, url: settings_path, method: :patch, class: "form stack" do |form| %>
    <%= render "shared/error_messages", record: @user %>

    <div class="form__field">
      <%= form.label :locale, class: "form__label" %>
      <%= form.select :locale,
                      I18n.available_locales.map { |locale| [ t("locale_switcher.names.#{locale}"), locale ] },
                      { include_blank: t("users.form.locale_unset") }, class: "form__input" %>
      <p class="form__hint"><%= t("users.form.locale_hint") %></p>
    </div>

    <fieldset class="form__fieldset">
      <legend class="form__label"><%= t("settings.mail_notifications") %></legend>
      <p class="form__hint"><%= t("settings.mail_notifications_hint") %></p>

      <% Notification::EVENTS.each do |event| %>
        <div class="form__field form__field--inline">
          <%= check_box_tag "mail_notifications[]", event, @user.mail_notifications_for?(event),
                            id: "mail_notifications_#{event}" %>
          <%= label_tag "mail_notifications_#{event}", t("settings.events.#{event}") %>
        </div>
      <% end %>
    </fieldset>

    <%= form.submit t("settings.submit"), class: "button button--primary" %>
  <% end %>
</div>

<ul class="list-plain">
  <li><%= link_to t("api_tokens.index.heading"), api_tokens_path %></li>
  <% if administrator? %>
    <li><%= link_to t("webhook_endpoints.index.heading"), webhook_endpoints_path %></li>
  <% end %>
</ul>
