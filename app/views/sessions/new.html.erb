<% content_for :title, t("sessions.new.title") %>

<div class="panel panel--narrow stack">
  <h1><%= t("sessions.new.heading") %></h1>

  <%= form_with url: session_path, class: "form stack" do |form| %>
    <div class="form__field">
      <%= form.label :email_address, t("activerecord.attributes.user.email_address"), class: "form__label" %>
      <%= form.email_field :email_address, required: true, autofocus: true,
                           autocomplete: "username", class: "form__input" %>
    </div>

    <div class="form__field">
      <%= form.label :password, t("activerecord.attributes.user.password"), class: "form__label" %>
      <%# パスワードの最大長は保存方式の上限に合わせる。 %>
      <%= form.password_field :password, required: true, autocomplete: "current-password",
                              maxlength: 72, class: "form__input" %>
    </div>

    <%= form.submit t("sessions.new.submit"), class: "button button--primary" %>
  <% end %>
</div>
