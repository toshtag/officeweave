<% content_for :title, t("sessions.new.title") %>

<div class="panel panel--narrow stack">
  <h1><%= t("sessions.new.heading") %></h1>

  <%= form_with url: session_path, class: "form stack" do |form| %>
    <%= form.field :email_address, :email_field, required: true, autofocus: true,
                   autocomplete: "username", label: t("activerecord.attributes.user.email_address") %>

    <% if @password_required %>
      <%# パスワードの最大長は保存方式の上限に合わせる。 %>
      <%= form.field :password, :password_field, required: true, autocomplete: "current-password",
                     maxlength: 72, label: t("activerecord.attributes.user.password") %>
    <% end %>

    <%= form.submit t("sessions.new.submit"), class: "button button--primary" %>
  <% end %>
</div>
