<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="OfficeWeave">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# app/assets/stylesheets 配下をすべて読み込む。優先順位はカスケードレイヤーで決まる。 %>
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <%# 反復する見出し領域を読み飛ばして本文へ移動するためのリンク。 %>
    <a class="skip-link" href="#main"><%= t("application.skip_to_content") %></a>

    <div class="page">
      <header class="page__header" role="banner">
        <div class="container page__masthead">
          <%= link_to t("application.name"), root_path, class: "page__brand" %>

          <div class="page__actions">
            <%= render "shared/locale_switcher" %>
            <% if authenticated? %>
              <%= link_to notifications_path, class: "button button--quiet" do %>
                <%= t("notifications.index.heading") %>
                <% if (count = unread_notification_count).positive? %>
                  <span class="badge badge--unread"><%= count %></span>
                <% end %>
              <% end %>
              <%= link_to t("settings.heading"), settings_path, class: "button button--quiet" %>
              <%= button_to t("sessions.sign_out"), session_path, method: :delete, class: "button button--quiet" %>
            <% end %>
          </div>
        </div>

        <% if authenticated? %>
          <div class="container">
            <%= render "shared/navigation" %>
          </div>
        <% end %>
      </header>

      <main class="page__main" id="main" tabindex="-1">
        <div class="container stack">
          <%= render "shared/flash" %>
          <%= yield %>
        </div>
      </main>

      <footer class="page__footer" role="contentinfo">
        <div class="container">
          <%= t("application.footer_note") %>
        </div>
      </footer>
    </div>
  </body>
</html>
