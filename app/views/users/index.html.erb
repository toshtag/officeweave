<% content_for :title, t("users.index.title") %>

<div class="stack">
  <div class="page-heading">
    <h1><%= t("users.index.heading") %></h1>
    <%= link_to t("users.index.new"), new_user_path, class: "button" %>
  </div>

  <p class="form__hint"><%= t("users.index.deactivation_hint") %></p>

  <form class="form form--inline" method="get" action="<%= users_path %>">
    <%= form_field do %>
      <%= label_tag :query, t("users.index.query"), class: "form__label" %>
      <%= search_field_tag :query, @query, class: "form__input" %>
    <% end %>

    <%= form_field do %>
      <%= label_tag :department_id, Department.model_name.human, class: "form__label" %>
      <%= select_tag :department_id,
                     options_from_collection_for_select(@departments, :id, :display_path, @department_id),
                     include_blank: t("users.index.all_departments"), class: "form__input" %>
    <% end %>

    <%= form_field do %>
      <%= label_tag :state, t("users.index.state"), class: "form__label" %>
      <%= select_tag :state,
                     options_for_select([ [ t("users.index.states.active"), "active" ],
                                          [ t("users.index.states.deactivated"), "deactivated" ] ], @state),
                     include_blank: t("users.index.all_states"), class: "form__input" %>
    <% end %>

    <%= submit_tag t("events.index.filter"), class: "button", name: nil %>
  </form>

  <p role="status"><%= t("pagination.total", count: @page.total_count) %></p>

  <div class="panel">
    <div class="table-scroll" tabindex="0" role="region"
         aria-label="<%= t("shared.table.scrollable") %>">
      <table>
        <thead>
          <tr>
            <th scope="col"><%= User.human_attribute_name(:name) %></th>
            <th scope="col"><%= User.human_attribute_name(:email_address) %></th>
            <th scope="col"><%= User.human_attribute_name(:role) %></th>
            <th scope="col"><%= Membership.human_attribute_name(:primary) %></th>
            <th scope="col"><%= t("users.index.status") %></th>
            <th scope="col"><span class="visually-hidden"><%= t("common.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= user.name %></td>
              <td><%= user.email_address %></td>
              <td><%= t("roles.#{user.role}") %></td>
              <td><%= user.primary_department&.name || t("departments.no_parent") %></td>
              <td>
                <% if user.active? %>
                  <%= t("users.status.active") %>
                <% else %>
                  <span class="status status--muted"><%= t("users.status.deactivated") %></span>
                <% end %>
              </td>
              <td class="table__actions">
                <%= link_to t("common.edit"), edit_user_path(user), class: "button button--quiet" %>
                <% if user.active? %>
                  <%= button_to t("users.deactivate"), user_activation_path(user),
                                method: :delete, class: "button button--quiet" %>
                <% else %>
                  <%= button_to t("users.activate"), user_activation_path(user),
                                method: :post, class: "button button--quiet" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%= render "shared/pagination", page: @page,
             parameters: { query: @query, department_id: @department_id, state: @state } %>
</div>
