<%= form_with model: user, class: "form stack" do |form| %>
  <%= render "shared/error_messages", record: user %>

  <%= form.field :name, :text_field, required: true %>
  <%= form.field :email_address, :email_field, required: true, autocomplete: "off" %>

  <%# 入力欄の制限は入力の助けにとどめる。受理するかどうかは User モデルの検証が決める。 %>
  <%= form.field :password, :password_field, required: user.new_record?,
                 minlength: Authentication::PasswordPolicy::MINIMUM_LENGTH, maxlength: 72,
                 autocomplete: "new-password",
                 hint: [ t("users.form.password_policy_hint", count: Authentication::PasswordPolicy::MINIMUM_LENGTH),
                         (t("users.form.password_hint") unless user.new_record?) ] %>
  <%= form.field :password_confirmation, :password_field,
                 minlength: Authentication::PasswordPolicy::MINIMUM_LENGTH, maxlength: 72,
                 autocomplete: "new-password" %>

  <%= form.field :role, :select, User.roles.keys.map { |role| [ t("roles.#{role}"), role ] }, {} %>
  <%= form.field :locale, :select,
                 I18n.available_locales.map { |locale| [ t("locale_switcher.names.#{locale}"), locale ] },
                 { include_blank: t("users.form.locale_unset") },
                 hint: t("users.form.locale_hint") %>

  <%= form.submit class: "button button--primary" %>
<% end %>
