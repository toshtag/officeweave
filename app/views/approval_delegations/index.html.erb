<% content_for :title, t("approval_delegations.index.title") %>

<div class="stack">
  <h1><%= t("approval_delegations.index.heading") %></h1>

  <p class="form__hint"><%= t("approval_delegations.index.description") %></p>

  <div class="panel panel--narrow stack">
    <h2><%= t("approval_delegations.new.heading") %></h2>

    <%= form_with model: @delegation, url: approval_delegations_path, class: "form stack" do |form| %>
      <%= render "shared/error_messages", record: @delegation %>

      <%# 自分自身は選べない。委任にならない。 %>
      <%= form.field :delegate_id, :collection_select,
                     @delegate_candidates.records,
                     :id, :name, { include_blank: true }, required: true %>
      <%= form.field :starts_on, :date_field, required: true %>
      <%= form.field :ends_on, :date_field, hint: t("approval_delegations.new.ends_on_hint") %>

      <%= form.submit t("approval_delegations.new.submit"), class: "button button--primary" %>
    <% end %>
  </div>

  <% if @delegations.any? %>
    <div class="panel">
      <div class="table-scroll" tabindex="0" role="region"
           aria-label="<%= t("shared.table.scrollable") %>">
        <table>
          <thead>
            <tr>
              <th scope="col"><%= ApprovalDelegation.human_attribute_name(:delegate) %></th>
              <th scope="col"><%= ApprovalDelegation.human_attribute_name(:starts_on) %></th>
              <th scope="col"><%= ApprovalDelegation.human_attribute_name(:ends_on) %></th>
              <th scope="col"><%= t("approval_delegations.index.status") %></th>
              <th scope="col"><span class="visually-hidden"><%= t("common.actions") %></span></th>
            </tr>
          </thead>
          <tbody>
            <% @delegations.each do |delegation| %>
              <tr data-delegation-id="<%= delegation.id %>">
                <td><%= delegation.delegate.name %></td>
                <td><%= l(delegation.starts_on, format: :long) %></td>
                <td><%= delegation.ends_on ? l(delegation.ends_on, format: :long) : t("approval_delegations.no_end") %></td>
                <td>
                  <% if delegation.active? %>
                    <%= t("approval_delegations.status.active") %>
                  <% else %>
                    <span class="status status--muted"><%= t("approval_delegations.status.inactive") %></span>
                  <% end %>
                </td>
                <td class="table__actions">
                  <%= button_to t("approval_delegations.delete"), approval_delegation_path(delegation),
                                method: :delete, class: "button button--quiet" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <%= render "shared/pagination", page: @page, parameters: {} %>
</div>
