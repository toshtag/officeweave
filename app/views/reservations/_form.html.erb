<%= form_with model: reservation, class: "form stack" do |form| %>
  <%= render "shared/error_messages", record: reservation %>

  <%= form.field :resource_id, :collection_select,
                 current_organization.resources.reservable.ordered, :id, :name,
                 { include_blank: true }, required: true %>
  <%= form.field :starts_at, :datetime_field, required: true %>
  <%= form.field :ends_at, :datetime_field, required: true %>
  <%= form.field :purpose, :text_field %>
  <%= form.field :event_id, :collection_select,
                 Event.visible_to(Current.user).starting_from(Time.current).chronological, :id, :title,
                 { include_blank: t("reservations.form.no_event") },
                 hint: t("reservations.form.event_hint") %>

  <%= form.submit class: "button button--primary" %>
<% end %>
