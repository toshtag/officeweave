<%= form_with model: reservation, class: "form stack" do |form| %>
  <%= render "shared/error_messages", record: reservation %>

  <div class="form__field">
    <%= form.label :resource_id, class: "form__label" %>
    <%= form.collection_select :resource_id, current_organization.resources.reservable.ordered,
                               :id, :name, { include_blank: true }, required: true, class: "form__input" %>
  </div>

  <div class="form__field">
    <%= form.label :starts_at, class: "form__label" %>
    <%= form.datetime_field :starts_at, required: true, class: "form__input" %>
  </div>

  <div class="form__field">
    <%= form.label :ends_at, class: "form__label" %>
    <%= form.datetime_field :ends_at, required: true, class: "form__input" %>
  </div>

  <div class="form__field">
    <%= form.label :purpose, class: "form__label" %>
    <%= form.text_field :purpose, class: "form__input" %>
  </div>

  <div class="form__field">
    <%= form.label :event_id, class: "form__label" %>
    <%= form.collection_select :event_id,
                               Event.visible_to(Current.user).starting_from(Time.current).chronological,
                               :id, :title, { include_blank: t("reservations.form.no_event") }, class: "form__input" %>
    <p class="form__hint"><%= t("reservations.form.event_hint") %></p>
  </div>

  <%= form.submit class: "button button--primary" %>
<% end %>
