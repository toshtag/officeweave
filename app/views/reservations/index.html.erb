<% content_for :title, t("reservations.index.title") %>

<div class="stack">
  <div class="page-heading">
    <h1><%= t("reservations.index.heading") %></h1>
    <%= link_to t("reservations.index.new"), new_reservation_path, class: "button" %>
  </div>

  <form class="form form--inline" method="get" action="<%= reservations_path %>">
    <%= form_field do %>
      <%= label_tag :from, t("events.index.from"), class: "form__label" %>
      <%= date_field_tag :from, @window.from, class: "form__input" %>
    <% end %>
    <%= form_field do %>
      <%= label_tag :to, t("events.index.to"), class: "form__label" %>
      <%= date_field_tag :to, @window.to, class: "form__input" %>
    <% end %>
    <%= submit_tag t("events.index.filter"), class: "button", name: nil %>
  </form>

  <p role="status">
    <%= t("events.index.period", from: l(@window.from, format: :long), to: l(@window.to, format: :long)) %>
    <% if @window.truncated? %>
      <%= t("shared.window.truncated", days: DateWindow::MAXIMUM_DAYS) %>
    <% end %>
  </p>

  <% if @reservations.any? %>
    <div class="panel">
      <table>
        <thead>
          <tr>
            <th scope="col"><%= Reservation.human_attribute_name(:resource) %></th>
            <th scope="col"><%= Reservation.human_attribute_name(:starts_at) %></th>
            <th scope="col"><%= Reservation.human_attribute_name(:ends_at) %></th>
            <th scope="col"><%= Reservation.human_attribute_name(:purpose) %></th>
            <th scope="col"><%= Reservation.human_attribute_name(:reserver) %></th>
            <th scope="col"><span class="visually-hidden"><%= t("common.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @reservations.each do |reservation| %>
            <tr>
              <td><%= reservation.resource.name %></td>
              <td><%= l(reservation.starts_at, format: :short) %></td>
              <td><%= l(reservation.ends_at, format: :short) %></td>
              <td><%= reservation.purpose %></td>
              <td><%= reservation.reserver.name %></td>
              <td>
                <% if reservation.modifiable_by?(Current.user) %>
                  <%= link_to t("common.edit"), edit_reservation_path(reservation),
                              class: "button button--quiet" %>
                <% end %>
                <% if reservation.modifiable_by?(Current.user) %>
                  <%= button_to t("reservations.cancel"), reservation, method: :delete,
                                class: "button button--quiet" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p><%= t("reservations.index.empty") %></p>
  <% end %>

  <%= render "shared/pagination", page: @page,
             parameters: { from: @window.from, to: @window.to } %>
</div>
