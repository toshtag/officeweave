<% content_for :title, t("request_types.index.title") %>

<div class="stack">
  <div class="page-heading">
    <h1><%= t("request_types.index.heading") %></h1>
    <% if administrator? %>
      <%= link_to t("request_types.index.new"), new_request_type_path, class: "button" %>
    <% end %>
  </div>

  <% if @request_types.any? %>
    <div class="panel">
      <table>
        <thead>
          <tr>
            <th scope="col"><%= RequestType.human_attribute_name(:name) %></th>
            <th scope="col"><%= RequestType.human_attribute_name(:approver_department) %></th>
            <th scope="col"><%= t("request_types.index.status") %></th>
            <th scope="col"><span class="visually-hidden"><%= t("common.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @request_types.each do |request_type| %>
            <tr>
              <td><%= request_type.name %></td>
              <td><%= request_type.approver_department&.display_path || t("request_types.approver_administrators") %></td>
              <td>
                <% if request_type.active? %>
                  <%= t("request_types.status.active") %>
                <% else %>
                  <span class="status status--muted"><%= t("request_types.status.inactive") %></span>
                <% end %>
              </td>
              <td class="table__actions">
                <% if request_type.active? %>
                  <%= link_to t("request_types.index.apply"),
                              new_request_path(request_type_id: request_type.id), class: "button button--quiet" %>
                <% end %>
                <% if administrator? %>
                  <%= link_to t("common.edit"), edit_request_type_path(request_type), class: "button button--quiet" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p><%= t("request_types.index.empty") %></p>
  <% end %>
</div>
