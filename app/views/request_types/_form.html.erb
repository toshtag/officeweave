<%# 段の階層は 1 度だけ読む。段ごとに読むと、段の数だけ問い合わせが増える。 %>
<% candidates = Candidates.new(current_organization.departments.ordered,
                                     query: params[:department_query],
                                     selected_ids: request_type.approval_steps.map(&:approver_department_id)) %>
<% departments = Department.with_ancestors(candidates.records) %>
<%= render "shared/candidate_search", candidates: candidates, name: :department_query,
                                     action: request.path, label: t("shared.candidates.departments"),
                                     parameters: {} %>

<%= form_with model: request_type, class: "form stack" do |form| %>
  <%= render "shared/error_messages", record: request_type %>

  <%= form.field :name, :text_field, required: true %>
  <%= form.field :code, :text_field, required: true %>
  <%= form.field :description, :text_area, rows: 4 %>
  <fieldset class="form__fieldset">
    <legend class="form__label"><%= t("request_types.form.approval_steps") %></legend>
    <%= form_hints t("request_types.form.approval_steps_hint") %>

    <%# 既にある段と、空の 1 段を並べる。JavaScript を使わずに増やせるようにする。 %>
    <%= form.fields_for :approval_steps do |step_form| %>
      <%= step_form.field :position, :number_field %>
      <%= step_form.field :approver_department_id, :collection_select,
                          departments, :id, :display_path,
                          { include_blank: t("request_types.form.approver_unset") } %>

      <% unless step_form.object.new_record? %>
        <%= inline_field do %>
          <%= step_form.check_box :_destroy %>
          <%= step_form.label :_destroy, t("request_types.form.remove_step"),
                              class: ApplicationFormBuilder::LABEL_CLASS %>
        <% end %>
      <% end %>
    <% end %>
  </fieldset>
  <%= form.field :position, :number_field %>

  <%= inline_field hint: t("request_types.form.active_hint") do %>
    <%= form.check_box :active %>
    <%= form.label :active, class: "form__label" %>
  <% end %>

  <%= form.submit class: "button button--primary" %>
<% end %>
