<%= form_with model: request_type, class: "form stack" do |form| %>
  <%= render "shared/error_messages", record: request_type %>

  <div class="form__field">
    <%= form.label :name, class: "form__label" %>
    <%= form.text_field :name, required: true, class: "form__input" %>
  </div>

  <div class="form__field">
    <%= form.label :code, class: "form__label" %>
    <%= form.text_field :code, required: true, class: "form__input" %>
  </div>

  <div class="form__field">
    <%= form.label :description, class: "form__label" %>
    <%= form.text_area :description, rows: 4, class: "form__input" %>
  </div>

  <div class="form__field">
    <%= form.label :approver_department_id, class: "form__label" %>
    <%= form.collection_select :approver_department_id, current_organization.departments.ordered,
                               :id, :display_path,
                               { include_blank: t("request_types.form.approver_unset") }, class: "form__input" %>
    <p class="form__hint"><%= t("request_types.form.approver_hint") %></p>
  </div>

  <div class="form__field">
    <%= form.label :position, class: "form__label" %>
    <%= form.number_field :position, class: "form__input" %>
  </div>

  <div class="form__field form__field--inline">
    <%= form.check_box :active %>
    <%= form.label :active, class: "form__label" %>
  </div>
  <p class="form__hint"><%= t("request_types.form.active_hint") %></p>

  <%= form.submit class: "button button--primary" %>
<% end %>
