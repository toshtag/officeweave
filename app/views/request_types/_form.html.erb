<%= form_with model: request_type, class: "form stack" do |form| %>
  <%= render "shared/error_messages", record: request_type %>

  <%= form.field :name, :text_field, required: true %>
  <%= form.field :code, :text_field, required: true %>
  <%= form.field :description, :text_area, rows: 4 %>
  <%= form.field :approver_department_id, :collection_select,
                 Department.with_ancestors(current_organization.departments.ordered),
                 :id, :display_path,
                 { include_blank: t("request_types.form.approver_unset") },
                 hint: t("request_types.form.approver_hint") %>
  <%= form.field :position, :number_field %>

  <%= inline_field hint: t("request_types.form.active_hint") do %>
    <%= form.check_box :active %>
    <%= form.label :active, class: "form__label" %>
  <% end %>

  <%= form.submit class: "button button--primary" %>
<% end %>
