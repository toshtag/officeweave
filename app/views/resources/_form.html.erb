<%= form_with model: resource, class: "form stack" do |form| %>
  <%= render "shared/error_messages", record: resource %>

  <%= form.field :name, :text_field, required: true %>
  <%= form.field :code, :text_field, required: true %>
  <%= form.field :capacity, :number_field, min: 1, hint: t("resources.form.capacity_hint") %>
  <%= form.field :description, :text_area, rows: 4 %>
  <%= form.field :position, :number_field %>

  <%= inline_field hint: t("resources.form.reservable_hint") do %>
    <%= form.check_box :reservable %>
    <%= form.label :reservable, class: "form__label" %>
  <% end %>

  <%= form.submit class: "button button--primary" %>
<% end %>
