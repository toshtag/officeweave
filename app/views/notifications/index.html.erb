<% content_for :title, t("notifications.index.title") %>

<div class="stack">
  <h1><%= t("notifications.index.heading") %></h1>

  <nav class="tabs" aria-label="<%= t("notifications.index.filters.label") %>">
    <ul class="tabs__list">
      <% [ [ nil, t("notifications.index.filters.all") ],
           [ "unread", t("notifications.index.filters.unread") ] ].each do |value, name| %>
        <li>
          <%= link_to name, notifications_path(read_state: value),
                      class: class_names("tabs__link", "tabs__link--current" => @read_state == value),
                      aria: { current: @read_state == value ? "page" : nil } %>
        </li>
      <% end %>
    </ul>
  </nav>

  <% if @notifications.any? %>
    <ul class="list-cards">
      <% @notifications.each do |notification| %>
        <li class="panel stack">
          <p class="timeline__summary">
            <%= link_to notification_path(notification) do %>
              <%= t("notifications.events.#{notification.event}", title: notification.subject_title) %>
            <% end %>
            <%= render "shared/unread_badge" unless notification.read? %>
          </p>
          <p class="meta"><%= l(notification.created_at, format: :short) %></p>
        </li>
      <% end %>
    </ul>

    <%= render "shared/pagination", page: @page, parameters: { read_state: @read_state } %>
  <% else %>
    <p><%= t("notifications.index.empty") %></p>
  <% end %>
</div>
