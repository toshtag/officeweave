<% content_for :title, @request.title %>

<div class="stack">
  <div class="panel stack">
    <div class="page-heading">
      <div>
        <h1><%= @request.title %></h1>
        <p class="meta">
          <%= @request.request_type.name %> ・
          <%= @request.applicant.name %> ・
          <%= render "requests/status", request: @request %>
        </p>
      </div>

      <div class="page-heading__actions">
        <% if @request.editable_by?(Current.user) %>
          <%= link_to t("common.edit"), edit_request_path(@request), class: "button" %>
          <%= button_to t("requests.submit"), request_submission_path(@request), method: :post,
                        class: "button button--primary" %>
        <% end %>
        <% if @request.withdrawable_by?(Current.user) %>
          <%= button_to t("requests.withdraw"), request_submission_path(@request), method: :delete,
                        class: "button" %>
        <% end %>
      </div>
    </div>

    <dl class="definition">
      <dt><%= Request.human_attribute_name(:submitted_at) %></dt>
      <dd><%= @request.submitted_at ? l(@request.submitted_at, format: :short) : t("requests.not_submitted") %></dd>

      <dt><%= t("requests.approval_route") %></dt>
      <dd>
        <%# 経路は提出の時点の段を写したもの。種別の段を後から変えても変わらない。 %>
        <ol class="list-plain">
          <% @request.route_steps.each do |step| %>
            <li>
              <%= step.approver_department&.display_path || t("request_types.approver_administrators") %>
              <% if step.try(:approved?) %>
                <%= t("requests.approved_by", name: step.approver&.name) %>
                <%= l(step.approved_at, format: :short) %>
              <% elsif @request.status == "pending" && step.position == @request.current_step_position %>
                <%# 待っている段を示す。多段では、どこで止まっているかが要る。 %>
                <span class="status status--muted"><%= t("requests.awaiting_step") %></span>
              <% end %>
            </li>
          <% end %>
        </ol>
      </dd>
    </dl>

    <% if @request.body.present? %>
      <div class="prose"><%= formatted_body @request.body %></div>
    <% end %>
  </div>

  <% if @request.decidable_by?(Current.user) %>
    <section class="panel panel--narrow stack" aria-labelledby="request-decision">
      <h2 id="request-decision"><%= t("request_decisions.heading") %></h2>

      <%= form_with url: request_decision_path(@request), class: "form stack" do |form| %>
        <%= form_field hint: t("request_decisions.comment_hint") do %>
          <%= label_tag :comment, t("request_decisions.comment"), class: "form__label" %>
          <%= text_area_tag :comment, nil, rows: 4, class: "form__input" %>
        <% end %>

        <div class="page-heading__actions">
          <%= form.button t("request_decisions.approve"), name: :decision, value: "approve",
                          class: "button button--primary" %>
          <%= form.button t("request_decisions.return"), name: :decision, value: "return", class: "button" %>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="panel stack" aria-labelledby="request-activities">
    <h2 id="request-activities"><%= t("request_activities.heading") %></h2>
    <%= render "requests/activities", activities: @activities %>
  </section>

  <p><%= link_to t("common.back"), requests_path %></p>
</div>
