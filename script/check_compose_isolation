#!/usr/bin/env bash
#
# 開発用と配布用の Compose 構成が分離されていることを検査する。
#
# ホスト側で実行する。Docker を必要とするため、コンテナ内のテストへは含めない。
# 検査するのは、破ると気付かないまま被害が出る不変条件だけとする。
#
#   1. project 名が開発用と配布用で異なる
#   2. データベースのボリューム名が開発用と配布用で異なる
#   3. 開発用データベースは通常構成でホストへ公開しない
#   4. web の既定の公開ポートが 3210
#   5. web の既定の公開アドレスが 127.0.0.1
#   6. override を重ねたときだけ、開発用データベースが 127.0.0.1:55432 へ公開される
#   7. 開発用と配布用の両方に worker がある
#   8. worker はホストへポートを公開しない
#   9. web と worker が同じジョブ用データベースを使う
#  10. 開発用と配布用のジョブ用データベース名が異なる
#  11. worker は web の稼働を待って起動する
#  12. 配布用の worker は再起動方針を持つ
#  13. 実行 thread 数がジョブ用データベースの接続数を超えない
#  14. 開発用と配布用の web と worker へ認証方式が同じ値で渡る
#  15. 認証方式が未設定の場合は internal が渡る
#  16. 明示した認証方式は補正されずに渡る
#  17. 明示した空文字が internal へ置き換えられない
#  18. 配布用の web と worker へ受け入れる Host が同じ値で渡る
#  19. 受け入れる Host が未設定の場合は localhost が渡る
#  20. 受け入れる Host の明示した空文字が localhost へ置き換えられない
#  21. 配布用の web と worker へ公開ポートが同じ値で渡る
#  22. 公開ポートが未設定の場合は空文字が渡る
#  23. 公開ポートの値を補正しない
#
# 使い方:
#   script/check_compose_isolation

set -euo pipefail

cd "$(dirname "$0")/.."

failures=0

report() {
  if [ "$1" = "ok" ]; then
    printf '  OK   %s\n' "$2"
  else
    printf '  NG   %s\n' "$2" >&2
    failures=$((failures + 1))
  fi
}

# 配布用の構成は必須の環境変数を要求する。検査のためだけの値を与える。
# .env の内容へ依存させると、手元と自動実行で結果が食い違う。
production_config() {
  env -i PATH="$PATH" HOME="$HOME" \
    DATABASE_USER=check \
    DATABASE_PASSWORD=check \
    SECRET_KEY_BASE=check \
    docker compose -f compose.production.yaml --env-file /dev/null config --format json
}

development_config() {
  env -i PATH="$PATH" HOME="$HOME" \
    docker compose -f compose.yaml --env-file /dev/null config --format json
}

development_with_database_config() {
  env -i PATH="$PATH" HOME="$HOME" \
    docker compose -f compose.yaml -f compose.database.yaml --env-file /dev/null config --format json
}

# 認証方式の伝播だけは、値を変えて解決し直す必要がある。
# 第 2 引数へ unset を渡した場合は、環境変数そのものを与えない。
config_with_provider() {
  local target="$1" setting="$2"
  local -a environment=(env -i PATH="$PATH" HOME="$HOME")

  if [ "$setting" != "unset" ]; then
    environment+=("AUTHENTICATION_PROVIDER=$setting")
  fi

  if [ "$target" = "production" ]; then
    environment+=(DATABASE_USER=check DATABASE_PASSWORD=check SECRET_KEY_BASE=check)
    "${environment[@]}" docker compose -f compose.production.yaml --env-file /dev/null config --format json
  else
    "${environment[@]}" docker compose -f compose.yaml --env-file /dev/null config --format json
  fi
}

# 公開先の設定も、値を変えて解決し直す。
# 配布用の構成にだけ渡る設定のため、production だけを対象とする。
config_with_setting() {
  local name="$1" setting="$2"
  local -a environment=(
    env -i PATH="$PATH" HOME="$HOME"
    DATABASE_USER=check DATABASE_PASSWORD=check SECRET_KEY_BASE=check
  )

  if [ "$setting" != "unset" ]; then
    environment+=("${name}=${setting}")
  fi

  "${environment[@]}" docker compose -f compose.production.yaml --env-file /dev/null config --format json
}

echo "Compose 構成の分離を検査します"

development="$(development_config)"
production="$(production_config)"
development_with_database="$(development_with_database_config)"

query() {
  python3 -c '
import json, sys
document = json.loads(sys.argv[1])
path = sys.argv[2].split(".")
for key in path:
    if document is None:
        break
    document = document.get(key) if isinstance(document, dict) else None
print(json.dumps(document))
' "$1" "$2"
}

development_name="$(query "$development" name | tr -d '"')"
production_name="$(query "$production" name | tr -d '"')"

if [ "$development_name" != "$production_name" ]; then
  report ok "project 名が異なる（開発 ${development_name} / 配布 ${production_name}）"
else
  report ng "project 名が同じ（${development_name}）。片方の down -v がもう片方を消し得る"
fi

development_volumes="$(query "$development" volumes)"
production_volumes="$(query "$production" volumes)"

shared_volumes="$(python3 -c '
import json, sys
left = set(json.loads(sys.argv[1]) or {})
right = set(json.loads(sys.argv[2]) or {})
print(" ".join(sorted(left & right)))
' "$development_volumes" "$production_volumes")"

if [ -z "$shared_volumes" ]; then
  report ok "データボリュームのキーが重複しない"
else
  report ng "データボリュームのキーが重複する（${shared_volumes}）"
fi

development_db_ports="$(query "$development" services.db.ports)"

if [ "$development_db_ports" = "null" ]; then
  report ok "開発用データベースを通常構成でホストへ公開しない"
else
  report ng "開発用データベースがホストへ公開されている（${development_db_ports}）"
fi

web_published="$(python3 -c '
import json, sys
ports = json.loads(sys.argv[1]) or []
for port in ports:
    if str(port.get("target")) == "3000":
        print("{}:{}".format(port.get("host_ip", ""), port.get("published", "")))
        break
' "$(query "$development" services.web.ports)")"

if [ "$web_published" = "127.0.0.1:3210" ]; then
  report ok "web の既定の公開先が 127.0.0.1:3210"
else
  report ng "web の既定の公開先が 127.0.0.1:3210 ではない（${web_published}）"
fi

production_web_published="$(python3 -c '
import json, sys
ports = json.loads(sys.argv[1]) or []
for port in ports:
    if str(port.get("target")) == "3000":
        print("{}:{}".format(port.get("host_ip", ""), port.get("published", "")))
        break
' "$(query "$production" services.web.ports)")"

if [ "$production_web_published" = "127.0.0.1:3210" ]; then
  report ok "配布用 web の既定の公開先が 127.0.0.1:3210"
else
  report ng "配布用 web の既定の公開先が 127.0.0.1:3210 ではない（${production_web_published}）"
fi

override_db_published="$(python3 -c '
import json, sys
ports = json.loads(sys.argv[1]) or []
for port in ports:
    if str(port.get("target")) == "5432":
        print("{}:{}".format(port.get("host_ip", ""), port.get("published", "")))
        break
' "$(query "$development_with_database" services.db.ports)")"

if [ "$override_db_published" = "127.0.0.1:55432" ]; then
  report ok "override 指定時だけ 127.0.0.1:55432 へ公開される"
else
  report ng "override 指定時の公開先が 127.0.0.1:55432 ではない（${override_db_published}）"
fi

# ---- worker ----

check_worker() {
  local label="$1" document="$2"

  if [ "$(query "$document" services.worker)" = "null" ]; then
    report ng "${label}に worker がない。ジョブが溜まるだけで実行されない"
    return
  fi

  report ok "${label}に worker がある"

  local ports
  ports="$(query "$document" services.worker.ports)"

  if [ "$ports" = "null" ]; then
    report ok "${label}の worker はホストへポートを公開しない"
  else
    report ng "${label}の worker がホストへポートを公開している（${ports}）"
  fi

  local web_queue worker_queue
  web_queue="$(query "$document" services.web.environment.QUEUE_DATABASE_NAME | tr -d '"')"
  worker_queue="$(query "$document" services.worker.environment.QUEUE_DATABASE_NAME | tr -d '"')"

  if [ "$web_queue" = "$worker_queue" ] && [ "$web_queue" != "null" ]; then
    report ok "${label}の web と worker が同じジョブ用データベースを使う（${web_queue}）"
  else
    report ng "${label}の web と worker でジョブ用データベースが違う（web ${web_queue} / worker ${worker_queue}）"
  fi

  local depends
  depends="$(query "$document" services.worker.depends_on.web.condition | tr -d '"')"

  if [ "$depends" = "service_healthy" ]; then
    report ok "${label}の worker は web の稼働を待って起動する"
  else
    report ng "${label}の worker が web の稼働を待っていない（${depends}）"
  fi

  local threads connections
  threads="$(query "$document" services.worker.environment.JOB_THREADS | tr -d '"')"
  connections="$(query "$document" services.worker.environment.QUEUE_DATABASE_CONNECTIONS | tr -d '"')"

  if [ "$threads" != "null" ] && [ "$connections" != "null" ] && [ "$threads" -le "$((connections - 2))" ]; then
    report ok "${label}の実行 thread 数が接続数に収まる（thread ${threads} / 接続 ${connections}）"
  else
    report ng "${label}の実行 thread 数が接続数に対して多い（thread ${threads} / 接続 ${connections}）"
  fi
}

check_worker "開発用" "$development"
check_worker "配布用" "$production"

production_worker_restart="$(query "$production" services.worker.restart | tr -d '"')"

if [ "$production_worker_restart" != "null" ]; then
  report ok "配布用の worker が再起動方針を持つ（${production_worker_restart}）"
else
  report ng "配布用の worker に再起動方針がない"
fi

development_queue="$(query "$development" services.web.environment.QUEUE_DATABASE_NAME | tr -d '"')"
production_queue="$(query "$production" services.web.environment.QUEUE_DATABASE_NAME | tr -d '"')"

if [ "$development_queue" != "$production_queue" ]; then
  report ok "ジョブ用データベース名が異なる（開発 ${development_queue} / 配布 ${production_queue}）"
else
  report ng "ジョブ用データベース名が同じ（${development_queue}）"
fi

# ---- 認証方式 ----
#
# 指定された名前が登録済みかどうかを判定するのは Compose の役目ではない。
# 値をそのまま web と worker へ届け、拒否は Rails の起動時に行う。
# 期待値は JSON のまま比べる。空文字と未指定を同じ表示にしない。

check_provider() {
  local target="$1" label="$2" setting="$3" expected="$4"
  local document web worker

  document="$(config_with_provider "$target" "$setting")"
  web="$(query "$document" services.web.environment.AUTHENTICATION_PROVIDER)"
  worker="$(query "$document" services.worker.environment.AUTHENTICATION_PROVIDER)"

  if [ "$web" = "$expected" ] && [ "$worker" = "$expected" ]; then
    report ok "${label}の web と worker へ認証方式が ${expected} で渡る"
  else
    report ng "${label}の認証方式が期待と異なる（期待 ${expected} / web ${web} / worker ${worker}）"
  fi
}

check_provider development "開発用の未設定時" unset '"internal"'
check_provider production "配布用の未設定時" unset '"internal"'
check_provider development "開発用の明示時" check-provider '"check-provider"'
check_provider production "配布用の明示時" check-provider '"check-provider"'
check_provider development "開発用の空文字" "" '""'
check_provider production "配布用の空文字" "" '""'

# 受け入れる Host も、認証方式と同じ契約にする。
# 空文字が既定値へ置き換わると、誤設定のまま localhost で起動してしまう。
#
# 公開ポートは web と worker の両方へ渡す。メールの本文は worker でも組み立てる。
# 片側だけへ渡すと、画面からは正しく見えるのに通知の URL だけが違う。
# 値の書式は compose では判定しない。起動時の検査が拒否する。
check_public_setting() {
  local name="$1" label="$2" setting="$3" expected="$4"
  local document web worker

  document="$(config_with_setting "$name" "$setting")"
  web="$(query "$document" "services.web.environment.${name}")"
  worker="$(query "$document" "services.worker.environment.${name}")"

  if [ "$web" = "$expected" ] && [ "$worker" = "$expected" ]; then
    report ok "${label}の web と worker へ ${name} が ${expected} で渡る"
  else
    report ng "${label}の ${name} が期待と異なる（期待 ${expected} / web ${web} / worker ${worker}）"
  fi
}

check_public_setting APPLICATION_HOST "配布用の未設定時" unset '"localhost"'
check_public_setting APPLICATION_HOST "配布用の明示時" officeweave.example.com '"officeweave.example.com"'
check_public_setting APPLICATION_HOST "配布用の空文字" "" '""'
check_public_setting APPLICATION_PORT "配布用の未設定時" unset '""'
check_public_setting APPLICATION_PORT "配布用の明示時" 3210 '"3210"'
check_public_setting APPLICATION_PORT "配布用の空文字" "" '""'

if [ "$failures" -eq 0 ]; then
  echo "分離の条件をすべて満たしています"
  exit 0
fi

echo "${failures} 件の条件を満たしていません" >&2
exit 1
