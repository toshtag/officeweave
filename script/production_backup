#!/usr/bin/env bash
#
# 配布環境のバックアップをホストへ取得する。
#
# 書庫はコンテナ内へ置かない。コンテナを入れ替えた時点で失われるためである。
# 一時コンテナが書庫を標準出力へ流し、このスクリプトがホスト側で受け取る。
#
# ホストのディレクトリをコンテナへマウントする方法は採らない。
# コンテナ内の利用者とホストの利用者で UID が食い違うと書き込めず、
# 書けた場合も root 所有の書庫が残るためである。
#
# データベースと添付ファイルの取得時点をそろえるため、取得中は web と worker を停止する。
# 取得のあいだ、利用者は画面を使えず、メールと Webhook も送られない。
#
# 先に web を止める。新しいジョブが投入されない状態にしてから worker を止める。
# 逆にすると、worker を止めた後に web が新しいジョブを積み、取得へ入らない。
#
# 使い方:
#   script/production_backup [ホスト側の出力ディレクトリ]
#
# 既定の出力先:
#   ./backups
#
# 環境変数:
#   BACKUP_KEEP             出力先へ残す書庫の数。指定した場合だけ古い書庫を消す
#   BACKUP_PASSPHRASE_FILE  パスフレーズのファイル。指定した場合だけ暗号化する

set -euo pipefail

cd "$(dirname "$0")/.."

# 暗号化の取り決めは、復元する側と共有する。
. script/lib/archive_cipher.sh

# 書庫には組織の全データが入る。最初から所有者だけが読める状態にする。
umask 077

output_directory="${1:-backups}"

# 残す書庫の数。既定を持たない。
#
# 既定を持たせると、この版へ入れ替えただけで書庫が消える組織が出る。
# 入れ替えの時点では、消える量も消える時刻も利用者へ見えない。
# 消す機能は、上限を明示した組織だけで働かせる。
keep="${BACKUP_KEEP:-}"

# 暗号化に使うパスフレーズのファイル。こちらも既定を持たない。
#
# 値そのものを環境変数で受け取らない。ファイルの経路だけを受け取る。
# 環境変数は、この処理から呼ぶ子プロセスすべてへ渡り、記録へ写り得る。
passphrase_file="${BACKUP_PASSPHRASE_FILE:-}"

compose() {
  docker compose -f compose.production.yaml "$@"
}

fail() {
  echo "$@" >&2
  exit 1
}

# 上限の検査は、サービスを止める前に行う。
# 取得を終えてから値の誤りで落ちると、停止と再開だけを繰り返すことになる。
if [ -n "${keep}" ]; then
  case "${keep}" in
    *[!0-9]*) fail "BACKUP_KEEP には 1 以上の整数を指定してください: ${keep}" ;;
  esac

  [ "${keep}" -ge 1 ] || fail "BACKUP_KEEP には 1 以上の整数を指定してください: ${keep}"
fi

# パスフレーズの検査も、サービスを止める前に行う。
if [ -n "${passphrase_file}" ]; then
  archive_cipher_check_passphrase_file "${passphrase_file}" || exit 1
fi

# 書庫の中身を暗号にする。鍵はパスフレーズから導出する。
# パスフレーズは引数へ渡さない。引数は同じホストの他の利用者から見える。
encrypt_to_stdout() {
  # shellcheck disable=SC2086
  openssl enc ${ARCHIVE_CIPHER_ARGUMENTS} -pass file:"${passphrase_file}"
}

decrypt_to_stdout() {
  # shellcheck disable=SC2086
  openssl enc -d ${ARCHIVE_CIPHER_ARGUMENTS} -pass file:"${passphrase_file}" -in "$1"
}

# 出力先にあるもののうち、このスクリプトが取得した書庫だけを、名前順に並べる。
#
# 名前は取得日時で始まるため、名前順が取得順になる。
# 同じ秒に 2 度取得したときだけ、連番付きのほうが先に並ぶ。
# その 2 つの間で古い側を取り違える可能性は残るが、
# 秒までそろった 2 つの書庫の間の順序であり、保持する期間には影響しない。
#
# 暗号化した書庫も同じ対象とする。整理の対象を平文だけにすると、
# 暗号化へ切り替えた組織で書庫が増え続ける。
list_archives() {
  local entry name

  for entry in "${output_directory}"/officeweave-*.tar.gz "${output_directory}"/officeweave-*.tar.gz.enc; do
    [ -e "${entry}" ] || continue

    name="$(basename "${entry}")"

    # 取得日時の形に一致しないものは、こちらが作ったものではない。
    # 出力先を他の用途と共有していても、触るのは自分が作ったものだけとする。
    [[ "${name}" =~ ^officeweave-[0-9]{8}T[0-9]{6}Z(-[0-9]+)?\.tar\.gz(\.enc)?$ ]] || continue

    echo "${entry}"
  done | sort
}

# 上限を超えた分を、古い側から消す。取得に成功したあとにだけ呼ぶ。
prune_old_archives() {
  local archives total excess status entry

  archives="$(list_archives)"
  [ -n "${archives}" ] || return 0

  total="$(printf '%s\n' "${archives}" | wc -l | tr -d ' ')"
  [ "${total}" -gt "${keep}" ] || return 0

  # head は最初の n 行で標準入力を閉じる。pipefail と組み合わせると、
  # 書き込む側が SIGPIPE で終わった時点でパイプライン全体が失敗する。
  excess="$(printf '%s\n' "${archives}" | sed -n "1,$((total - keep))p")"

  status=0

  while IFS= read -r entry; do
    [ -n "${entry}" ] || continue

    if rm -f "${entry}" 2>/dev/null; then
      echo "保持の上限を超えたため削除しました: ${entry}" >&2
    else
      echo "古い書庫を削除できませんでした: ${entry}" >&2
      status=1
    fi
  done <<ARCHIVES
${excess}
ARCHIVES

  return "${status}"
}

# 稼働中のサービスを一度だけ読み、変数の上で判定する。
# `compose ps | grep -q` の形にすると、grep が最初の一致で終了した時点で
# compose 側が SIGPIPE で死に、pipefail によってパイプライン全体が失敗する。
running_services=""

read_running_services() {
  running_services="$(compose ps --status running --services 2>/dev/null || true)"
}

service_running() {
  case "
${running_services}
" in
    *"
$1
"*) return 0 ;;
  esac

  return 1
}

read_running_services

if ! service_running db; then
  fail "データベースが起動していません。先に docker compose -f compose.production.yaml up -d を実行してください。"
fi

# 元々停止していたサービスを、この処理の副作用で起動しない。
web_was_running=0
worker_was_running=0
service_running web && web_was_running=1
service_running worker && worker_was_running=1

# 運用環境は APPLICATION_HOST 以外の Host を拒否する。
# ループバックへ直接要求するため、Host は明示する。
# 参照する値は web コンテナ内のものとする。ホスト側の環境変数を使うと、
# 実際に web へ渡っている値と食い違ったときに気付けない。
wait_for_web() {
  for _ in $(seq 1 60); do
    if compose exec -T web sh -c \
      'curl -sf -H "Host: ${APPLICATION_HOST}" http://127.0.0.1:3000/up' >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done

  return 1
}

# 再開は web から行う。worker は web の稼働を前提に起動する。
restart_services() {
  if [ "${web_was_running}" -eq 1 ]; then
    echo "web を再開しています" >&2
    compose start web >/dev/null 2>&1 ||
      fail "web を再開できませんでした。docker compose -f compose.production.yaml logs web を確認してください。"

    wait_for_web ||
      fail "web が応答しません。docker compose -f compose.production.yaml logs web を確認してください。"
  fi

  if [ "${worker_was_running}" -eq 1 ]; then
    echo "worker を再開しています" >&2
    compose start worker >/dev/null 2>&1 ||
      fail "worker を再開できませんでした。docker compose -f compose.production.yaml logs worker を確認してください。"

    wait_for_worker ||
      fail "worker が応答しません。docker compose -f compose.production.yaml logs worker を確認してください。"
  fi
}

wait_for_worker() {
  for _ in $(seq 1 60); do
    if compose exec -T worker bin/jobs_alive >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done

  return 1
}

if [ "${web_was_running}" -eq 1 ]; then
  echo "取得のあいだ web を停止します。画面は一時的に使えなくなります。" >&2
  compose stop web >/dev/null
fi

if [ "${worker_was_running}" -eq 1 ]; then
  echo "worker を停止します。実行中のジョブの終了を待ちます。" >&2
  compose stop worker >/dev/null
fi

mkdir -p "${output_directory}"

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"

# 暗号化したものは .enc で終わらせる。中身の判定は名前ではなく先頭の印で行うが、
# 保管先で平文と混ざったときに、名前だけで見分けられるほうがよい。
extension="tar.gz"
if [ -n "${passphrase_file}" ]; then
  extension="tar.gz.enc"
fi

archive="${output_directory}/officeweave-${timestamp}.${extension}"

if [ -e "${archive}" ]; then
  suffix=1
  while [ -e "${output_directory}/officeweave-${timestamp}-${suffix}.${extension}" ]; do
    suffix=$((suffix + 1))
  done
  archive="${output_directory}/officeweave-${timestamp}-${suffix}.${extension}"
fi

# 完成するまでは正式な名前を使わない。
# 途中で失敗した書庫が、使える書庫として残らないようにする。
partial="${archive}.partial"

cleanup_partial() {
  rm -f "${partial}"
}

echo "書庫を取得しています" >&2

# --no-deps を付け、db を巻き込んで作り直さないようにする。
# -T を付け、標準出力へ端末の制御文字が混ざらないようにする。
#
# 暗号化は、書庫がホストへ届く途中で行う。平文をいったん置いてから
# 暗号化する形にすると、消し忘れた平文が保管先へ残り得る。
# pipefail のもとでは、取得と暗号化のどちらが失敗しても失敗になる。
receive_archive() {
  if [ -n "${passphrase_file}" ]; then
    compose run --rm --no-deps -T web bin/backup --stdout | encrypt_to_stdout > "${partial}"
  else
    compose run --rm --no-deps -T web bin/backup --stdout > "${partial}"
  fi
}

if ! receive_archive; then
  cleanup_partial
  restart_services
  fail "バックアップの取得に失敗しました。"
fi

# 取得したものが、取り出せる形になっているかを確かめる。
#
# 暗号化した場合は、復号してから確かめる。復号の確認を省くと、
# パスフレーズの取り違えに気付くのは復元を試みたときになる。
if [ -n "${passphrase_file}" ]; then
  if ! decrypt_to_stdout "${partial}" 2>/dev/null | tar --list --gzip >/dev/null 2>&1; then
    cleanup_partial
    restart_services
    fail "取得した書庫を復号して読み取れません。"
  fi
else
  if ! gzip --test "${partial}" 2>/dev/null; then
    cleanup_partial
    restart_services
    fail "取得した書庫を読み取れません。"
  fi

  if ! tar --list --gzip --file="${partial}" >/dev/null 2>&1; then
    cleanup_partial
    restart_services
    fail "取得した書庫を書庫として読み取れません。"
  fi
fi

mv "${partial}" "${archive}"

restart_services

echo "取得しました: ${archive}" >&2

# 整理は、取得と再開を終えてから行う。
# 消してから取得すると、取得が失敗した時点で残りが 1 世代分少ない状態になる。
prune_status=0

if [ -n "${keep}" ]; then
  prune_old_archives || prune_status=1
fi

# 整理に失敗した場合も、取得した書庫の経路は伝える。
# 伝えないと、受け取った側は作られた書庫を見つけられないまま失敗を受け取る。
echo "${archive}"

exit "${prune_status}"
