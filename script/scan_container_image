#!/usr/bin/env bash
#
# 配布するイメージの既知の脆弱性を検査する。
#
# 依存の監査は Gemfile.lock を見る。イメージへ入っている OS のパッケージは
# 見ない。配布しているのはイメージであり、そこに含まれるものすべてが対象である。
#
# ホスト側で実行する。Docker を必要とし、脆弱性のデータベースを取得するため、
# 一括検証へは含めない。一括検証は実行のたびに同じ結果になることを条件にしている。
#
# 検査するのは次の 2 つである。
#
#   1. 配布用の Dockerfile から組み立てたイメージ
#   2. 配布用の構成が使うデータベースのイメージ
#
# 2 を含めるのは、配布しているのが構成の全体だからである。
# 自分たちが書いた側だけを検査しても、動かすものの半分しか見ていない。
#
# 合否を決めるのは 1 だけとする。1 は入れるパッケージを選べるが、2 に対する
# 手立ては tag を上げることだけであり、上げても解消しない場合がある。
# 解消できない指摘で検証を止め続けると、失敗を無視する習慣がつく。
# 2 は報告として残し、tag を上げる判断の材料にする。
#
# 修正版のある指摘があれば失敗する。修正版が出ていない指摘は報告へ残すが、
# 失敗させない。自分たちで解消できない状態で検証が止まり続ける。
# 失敗させないことと、見せないことは別である。
#
# 使い方:
#   script/scan_container_image
#
#   報告は scan_report/ へ書き出す。

set -euo pipefail

cd "$(dirname "$0")/.."

# 検査器は digest で固定する。中身が後から変わると、同じ commit を検査しても
# 結果が変わる。版は注記として残す。識別子だけでは、どの版か読めない。
SCANNER="aquasec/trivy:0.72.0@sha256:cffe3f5161a47a6823fbd23d985795b3ed72a4c806da4c4df16266c02accdd6f"

# 直す判断の対象にする下限。これより低いものは報告にも残さない。
# すべてを出すと、直すべきものが埋もれる。
SEVERITY="HIGH,CRITICAL"

APP_IMAGE="officeweave-scan-target:latest"

REPORT_DIR="scan_report"

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# 脆弱性のデータベースは取得に時間がかかる。1 回の実行の中では使い回す。
mkdir -p "$WORK/cache"

rm -rf "$REPORT_DIR"
mkdir -p "$REPORT_DIR"

failed=0

# 検査器を走らせる。
#
# イメージは tar へ書き出して読ませる。ホストの Docker の socket は渡さない。
# 渡すと、検査器がホストの Docker を操作できる。検査するだけなら、書き出した
# 内容を読ませれば足りる。
scanner() {
  local archive="$1"
  shift

  # 検査器はホストの利用者として動かす。root で動かすと、置いていった
  # 脆弱性のデータベースをホスト側で消せず、後片付けが失敗する。
  docker run --rm \
    --user "$(id -u):$(id -g)" \
    -e TRIVY_CACHE_DIR=/work/cache \
    -v "$WORK:/work" \
    -v "$PWD/$REPORT_DIR:/report" \
    "$SCANNER" image \
    --input "/work/${archive}" \
    --severity "$SEVERITY" \
    --scanners vuln \
    --quiet \
    "$@"
}

# 指摘の件数を数える。
#
# 数えるのはコンテナの中で行う。ホストへ ruby を要求すると、この検査を
# 実行できる環境が狭まる。組み立てたイメージには ruby が入っている。
count_findings() {
  docker run --rm --entrypoint ruby \
    --user "$(id -u):$(id -g)" \
    -v "$PWD/$REPORT_DIR:/report" \
    "$APP_IMAGE" -rjson -e '
      document = JSON.parse(File.read(ARGV.fetch(0), encoding: "UTF-8"))
      puts document.fetch("Results", []).sum { |result| result.fetch("Vulnerabilities", []).size }
    ' "/report/$(basename "$1")"
}

# 書き出しと報告。tar は検査ごとに名前を分ける。同じ名前へ書き直すと、
# 共有した内容が前の検査のまま残ることがある。
prepare() {
  local label="$1" image="$2" name="$3"

  echo
  echo "== ${label}: ${image}"

  docker save "$image" -o "$WORK/${name}.tar"
}

report() {
  local name="$1"

  # 修正版が無いものも報告へ残す。一覧をそのまま流すと、直すべきものが
  # 埋もれる。件数だけをここへ出す。
  scanner "${name}.tar" --exit-code 0 --format json --output "/report/${name}.json"

  echo "-- 報告: ${REPORT_DIR}/${name}.json（$(count_findings "${REPORT_DIR}/${name}.json") 件）"

  rm -f "$WORK/${name}.tar"
}

# 自分たちが組み立てるイメージ。修正版のある指摘があれば失敗する。
scan_and_gate() {
  prepare "$1" "$2" "$3"

  echo "-- 修正版のある指摘"
  if ! scanner "$3.tar" --ignore-unfixed --exit-code 1 --table-mode detailed; then
    failed=1
  fi

  report "$3"
}

# 取り込む第三者のイメージ。指摘を報告するが、合否には使わない。
scan_and_report() {
  prepare "$1" "$2" "$3"

  report "$3"
}

echo "配布用のイメージを組み立てています"
docker build --quiet -f Dockerfile.production -t "$APP_IMAGE" . > /dev/null

scan_and_gate "配布用のイメージ" "$APP_IMAGE" application

# 構成から読む。版を書き写すと、構成の側を上げたときに古い版を検査し続ける。
#
# 行の順ではなく、名前で選ぶ。構成には web と worker のイメージも書いてあり、
# 順で選ぶと、その並びを入れ替えただけで別のものを検査することになる。
db_image="$(grep -oE '^[[:space:]]+image:[[:space:]]+postgres:[^[:space:]]+' compose.production.yaml |
  head -n 1 | awk '{ print $2 }')"

if [ -z "$db_image" ]; then
  echo "配布用の構成からデータベースのイメージ名を読めませんでした" >&2
  exit 1
fi

docker pull --quiet "$db_image" > /dev/null

scan_and_report "データベースのイメージ" "$db_image" database

echo
for name in application database; do
  if [ ! -s "${REPORT_DIR}/${name}.json" ]; then
    echo "報告が書き出されていません: ${REPORT_DIR}/${name}.json" >&2
    exit 1
  fi
done

if [ "$failed" -ne 0 ]; then
  echo "修正版のある脆弱性が見つかりました。更新して解消してください。" >&2
  exit 1
fi

echo "組み立てたイメージに、修正版のある脆弱性は見つかりませんでした。"
